# AWS region where the monitoring stack will be deployed
aws_region = "us-east-1"

# The SSH public key content that corresponds to your local private key.
# This will be added to the EC2 instance's authorized_keys.
# Replace with your actual public key (e.g. cat ~/.ssh/id_rsa.pub or id_ed25519.pub)
ssh_public_key = "ssh-rsa AAAAB3NzaC1yc2EAAAADAQABAAABAQD..."

# CIDR block allowed to access SSH (22), Grafana (3000), Prometheus (9090), and Demo App (8000).
# For production/security, replace this with your own public IP address (e.g. "123.45.67.89/32")
allowed_cidr = "0.0.0.0/0"

# Optional project prefix tag
project_name = "devops-monitoring"

# Optional EC2 instance type override (t3.micro is free-tier eligible)
instance_type = "t3.micro"
